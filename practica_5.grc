- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"VCO Complex - genera se\xF1al compleja a partir de amplitud y fase\"\
      \"\"\n\n    def __init__(self):\n        gr.sync_block.__init__(\n         \
      \   self,\n            name='VCO complex',\n            in_sig=[np.float32,\
      \ np.float32],\n            out_sig=[np.complex64]\n        )\n\n    def work(self,\
      \ input_items, output_items):\n        amplitude = input_items[0]\n        phase\
      \ = input_items[1]\n        output = output_items[0]\n        output[:] = amplitude\
      \ * np.exp(1j * phase)\n        return len(output)\n\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: "('VCO complex', 'blk', [], [('0', 'float', 1), ('1', 'float', 1)],\
      \ [('0', 'complex', 1)], 'VCO Complex - genera se\xF1al compleja a partir de\
      \ amplitud y fase', [])"
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1616, 260.0]
    rotation: 0
    state: enabled
